# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment files
.env*

# pytest caches
.pytest_cache/
.testmondata*
# --basetemp roots and their logs. Kept out of the tree for the same reason they
# are kept out of the build context: they are per-run scratch, and a `git add -A`
# would otherwise sweep them in.
.pytest-temp-*

# Remediation audit trails. The applied run and PROVENANCE.md are committed -
# they are the record of rows destroyed in production. Dry runs are reproducible
# by re-running the script, so they are not.
var/end_client_remediation/*-dryrun.json
var/recruiter_identity_remediation/*-dryrun.json

# Pre-apply table dumps. Rollback material rather than a record: a data-only
# dump of live contact rows, which belongs on the machine that made it and not
# in the history. What each run changed is in its own audit file.
var/*/pre-apply-*.sql
